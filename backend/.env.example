# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (conteneur taskify-db publié sur 5434) ---
DB_NAME=taskify
